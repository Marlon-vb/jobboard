# Copy this file to ".env" and fill in your keys, then run `npm run scrape`.
# The .env file is git-ignored — your keys stay on your machine.

# ── Adzuna (recommended) ─────────────────────────────────────────────────────
# Adzuna's own free API. Register (2 min) at https://developer.adzuna.com/ and
# paste your App ID + App Key below. This is the most reliable European source.
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Optional tuning for Adzuna:
# ADZUNA_QUERY=diversity inclusion equity belonging dei
# ADZUNA_COUNTRIES=gb,de,nl,fr,es,it,at,be,ch,pl
# ADZUNA_RESULTS=50

# ── Adzuna via Apify (alternative) ───────────────────────────────────────────
# Only used if the ADZUNA_APP_ID/KEY above are NOT set. Runs an Adzuna scraper
# actor on Apify. Token: https://console.apify.com/account/integrations
# APIFY_TOKEN=your_apify_token_here
# APIFY_ADZUNA_ACTOR=powerbox~adzuna-jobs-search-scraper
# APIFY_ADZUNA_INPUT={"startUrls":[{"url":"https://www.adzuna.co.uk/search?q=diversity%20inclusion"}],"maxItems":100}
# APIFY_MAX_ITEMS=200

# Optional: pull DEI roles straight from companies' own ATS boards.
# GREENHOUSE_BOARDS=elastic,mongodb
# LEVER_BOARDS=netflix,plaid
