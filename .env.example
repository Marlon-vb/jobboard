# Copy this file to ".env" and fill in your keys, then run `npm run scrape`.
# The .env file is git-ignored — your keys stay on your machine.

# Adzuna via Apify — runs an Adzuna scraper actor on Apify and pulls the results.
# Get a free API token at https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Optional: which Adzuna scraper actor to run (id uses ~, not /).
# Pick one from https://apify.com/store?search=adzuna
# APIFY_ADZUNA_ACTOR=powerbox~adzuna-jobs-search-scraper

# Optional: the exact input JSON for your chosen actor (copy it from the actor's
# page on Apify). If set, this overrides the default search input entirely.
# APIFY_ADZUNA_INPUT={"startUrls":[{"url":"https://www.adzuna.co.uk/search?q=diversity%20inclusion"}],"maxItems":100}

# Optional: search query + which European Adzuna sites to build default URLs for.
# ADZUNA_QUERY=diversity inclusion
# ADZUNA_COUNTRIES=gb,de,nl,fr
# APIFY_MAX_ITEMS=200

# Optional: pull DEI roles straight from companies' own ATS boards.
# GREENHOUSE_BOARDS=elastic,mongodb
# LEVER_BOARDS=netflix,plaid
