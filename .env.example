# Copy this file to ".env" and fill in your keys, then run `npm run scrape`.
# The .env file is git-ignored — your keys stay on your machine.

# Adzuna — free API for country-by-country European job search.
# Get an App ID + App Key (free) at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Optional: which Adzuna European country endpoints to query (comma-separated).
# Defaults to: gb,de,fr,nl,es,it,at,be,ch,pl
# ADZUNA_COUNTRIES=gb,de,nl,fr

# Optional: pull DEI roles straight from companies' own ATS boards.
# GREENHOUSE_BOARDS=elastic,mongodb
# LEVER_BOARDS=netflix,plaid
